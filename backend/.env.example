# Copy to .env for local use. On a host, set these as environment variables instead.
HELIUS_API_KEY=your-helius-key

# Required when the page is on another domain: comma-separated origins, with no trailing path.
ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional: a full RPC URL, used instead of HELIUS_API_KEY.
# RPC_URL=
